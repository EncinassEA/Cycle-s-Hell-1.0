  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CyclesHell.Interaction.CluePickup
  clueId: Cabana_Clue_2
  promptText: '[E] Examinar Pista'
  inspectedPromptText: '[E] Releer Pista'
  clueTitle: "PISTA 2/3 \u2014 GRABACI\xD3N Y DIARIO DEL PISO SUPERIOR"
  clueDate: "05 DE NOVIEMBRE DE 2004 \u2014 CUARTO SECUNDARIO"
  clueBody: "Cuaderno manchado de humedad encontrado en el cuarto oscuro de arriba:\n\n\"Otra noche sin dormir. Los rasgu\xF1os no vienen del bosque... vienen DEBAJO de la caba\xF1a. En el Estudio de planta baja el librero del fondo suena completamente hueco.\n\nEl due\xF1o anterior instal\xF3 una palanca escondida en la pared de la REC\xC1MARA PRINCIPAL para moverlo. Sea lo que sea que encerraron ah\xED abajo, ya sabe que estamos aqu\xED.\""
  linkedJumpscare: {fileID: 0}
  highlightMarkerRenderer: {fileID: 2066967042}
